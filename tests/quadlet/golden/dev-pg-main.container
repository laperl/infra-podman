# Ansible managed
[Unit]
Description=PostgreSQL main (dev)

[Container]
ContainerName=dev-pg-main
Image=docker.io/pgvector/pgvector@sha256:c29f30688a9ad961691bdf0ec1650717cc132a5814619d80f80463d6e4c42e47
Label=infra.env=dev
Label=infra.app=pg-main
Label=infra.component=db
Label=infra.managed-by=infra-podman

# PostgreSQL 18 images keep PGDATA in /var/lib/postgresql/18/docker: mount the parent.
Volume=dev-pg-main-data.volume:/var/lib/postgresql:Z
# Access rules generated by Ansible, read-only (docs/POSTGRES.md, section 3). The
# directory, not the file: Ansible replaces the file with a new one, and a mount of the
# file itself would keep showing the old one to PostgreSQL after a reload.
Volume=/home/svc_runner/.config/infra-podman/dev-pg-main:/etc/postgresql:ro,Z

# Only read on the first start, with an empty volume (R34, docs/POSTGRES.md, section 1).
# The superuser password arrives as a file, never as a variable (SPEC 4.5).
Environment=POSTGRES_USER=ci_admin
Environment=POSTGRES_DB=postgres
Environment="POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8 --locale-provider=builtin --builtin-locale=C.UTF-8 --data-checksums"
Secret=dev-pg-main-superuser-password,type=mount,target=/run/secrets/postgres-password,mode=0400
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password

# The image's command, plus our pg_hba.conf and the time zone on every start.
Exec=postgres -c hba_file=/etc/postgresql/pg_hba.conf -c timezone=UTC -c log_timezone=UTC

# No published ports (SPEC 4.4). One internal, isolated network per consumer (D9, R45);
# without consumers, no network at all.
Network=dev-ai-pg-main-net.network
Network=dev-demo-pg-main-net.network
Network=dev-ff-ci-pg-main-net.network

# Through the socket, which pg_hba.conf allows: over TCP every probe would be rejected and
# logged. Healthy only when the final server runs: during the first initialisation the
# image runs a temporary server with listen_addresses empty. Podman runs it with sh -c.
HealthCmd=psql -XAtq -U ci_admin -d postgres -c "SHOW listen_addresses" | grep -q .
HealthInterval=30s
HealthStartPeriod=60s
HealthRetries=3
HealthTimeout=5s

# Hardening (docs/POSTGRES.md, section 1): read-only root filesystem, writable only in
# the volume and these two tmpfs; only the capabilities the image's entrypoint needs to
# prepare its directories and drop to the postgres user.
ReadOnly=true
Tmpfs=/var/run/postgresql
Tmpfs=/tmp
DropCapability=all
AddCapability=CHOWN SETUID SETGID FOWNER DAC_OVERRIDE
NoNewPrivileges=true
# Resource limits: the only place they are written (docs/COMPATIBILITY.md).
PodmanArgs=--memory=1g --cpus=2
PidsLimit=500
ShmSize=256m

[Service]
Restart=on-failure
# Quadlet waits for the container to start; the image is pulled beforehand by Ansible.
TimeoutStartSec=120
# PostgreSQL needs time to write a checkpoint on a clean shutdown.
TimeoutStopSec=90

[Install]
WantedBy=default.target
