# Ansible managed
# Observability store, logs (SPEC 4.8, R62): VictoriaLogs, single node. The machines
# send to it with systemd-journal-upload; it connects to none. Its data is a folder of the
# machine, obs_store_dir, not a Podman volume: it may live on an encrypted external disk.
# Published where obs_store_logs_networking says (R55): by default on 127.0.0.1, and the
# other machines reach it through `tailscale serve`.
[Unit]
Description=Observability store, logs, VictoriaLogs (dev)

[Container]
ContainerName=dev-obs-logs
Image=docker.io/victoriametrics/victoria-logs@sha256:ee4e820cac3721f5f5d91641b950c22439593adc4224f9655e5333d5a84c1dfe
Label=infra.env=dev
Label=infra.app=obs
Label=infra.component=logs
Label=infra.managed-by=infra-podman
# Logs to the journal of the service user, whatever the default of Podman on the machine
# (SPEC 4.8, R60).
LogDriver=journald

Volume=/home/svc_runner/.local/share/infra-podman/dev-obs/logs:/storage:Z
# The arguments of /victoria-logs-prod, the image's entrypoint.
Exec=-storageDataPath=/storage -retentionPeriod=90d -httpListenAddr=:9428
# Its own internal network: no way out (R58). The ports are published from it.
Network=dev-obs-logs-net.network
PublishPort=127.0.0.1:18011:9428

# Resource limits (R46): the only place they are written.
PodmanArgs=--memory=1g --cpus=2
PidsLimit=500
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
