# Ansible managed
# Copies of the backups received by dev-backup-server, encrypted by restic on the
# client. Never removed when the service is destroyed (SPEC 4.2).
[Volume]
VolumeName=dev-backup-server-data
Label=infra.env=dev
Label=infra.app=backup
Label=infra.component=data
Label=infra.managed-by=infra-podman
