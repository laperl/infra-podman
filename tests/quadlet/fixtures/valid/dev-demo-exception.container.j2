# Fixture: a unit that skips one hardening rule with an approved exception (R51). The
# decision cited must exist in docs/DECISIONS.md; here it is R51 itself.
# policy-exception: drop-capability (R51)
[Unit]
Description=Demo container with a policy exception (CI fixture)

[Container]
ContainerName={{ infra_env }}-demo-exception
Image={{ demo_image }}
