# {{ ansible_managed | default('Managed by infra-podman') }}
# Network of one consumer of {{ postgres_name }} (D9, SPEC 4.4): only that consumer and this
# instance. Internal: no way out to the internet, the LAN or the host, not even by DNS.
# Isolated from every other isolated network. No Subnet=: Podman chooses a free one, and
# the role reads it for pg_hba.conf (docs/POSTGRES.md, section 3).
[Network]
NetworkName={{ item.name | regex_replace('\.network$', '') }}
Internal=true
Options=isolate=true
# Podman's DNS of the network resolves the names of its containers and sends any other
# question to the host's servers, even on an internal network (aardvark-dns 1.4, Podman
# 4.9): a way out for data. Sent here instead, where nothing answers (R45).
DNS=127.0.0.1
Label=infra.env={{ infra_env }}
Label=infra.app=pg-{{ postgres_instance }}
Label=infra.component=net
Label=infra.managed-by=infra-podman
