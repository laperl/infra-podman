# {{ ansible_managed | default('Managed by infra-podman') }}
[Unit]
Description=PostgreSQL {{ postgres_instance }} ({{ infra_env }})

[Container]
ContainerName={{ postgres_name }}
Image={{ postgres_image }}
Label=infra.env={{ infra_env }}
Label=infra.app=pg-{{ postgres_instance }}
Label=infra.component=db
Label=infra.managed-by=infra-podman

# PostgreSQL 18 images keep PGDATA in /var/lib/postgresql/18/docker: mount the parent.
Volume={{ postgres_volume }}.volume:/var/lib/postgresql:Z
# Access rules generated by Ansible, read-only (docs/POSTGRES.md, section 3).
Volume={{ postgres_hba_file }}:/etc/postgresql/pg_hba.conf:ro,Z

# Only read on the first start, with an empty volume (R34, docs/POSTGRES.md, section 1).
# The superuser password arrives as a file, never as a variable (SPEC 4.5).
Environment=POSTGRES_USER={{ postgres_superuser }}
Environment=POSTGRES_DB=postgres
Environment="POSTGRES_INITDB_ARGS={{ postgres_initdb_args }}"
Secret={{ postgres_secret }},type=mount,target=/run/secrets/postgres-password,mode=0400
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password

# The image's command, plus our pg_hba.conf and the time zone on every start.
Exec=postgres -c hba_file=/etc/postgresql/pg_hba.conf -c timezone={{ postgres_timezone }} -c log_timezone={{ postgres_timezone }}

# No published ports (SPEC 4.4). Each consumer gets its own isolated network (D9).
{% for consumer in postgres_consumers %}
Network={{ infra_env }}-{{ consumer }}-pg-{{ postgres_instance }}-net.network
{% else %}
Network=none
{% endfor %}

# Healthy only when the final server accepts TCP on its own loopback: during the first
# initialisation the image runs a temporary server on the Unix socket only. pg_isready
# does not log in, so the TCP rejection in pg_hba.conf does not affect it.
HealthCmd=pg_isready --quiet --host 127.0.0.1 --username {{ postgres_superuser }} --dbname postgres
HealthInterval=30s
HealthStartPeriod=60s
HealthRetries=3
HealthTimeout=5s

# Hardening (docs/POSTGRES.md, section 1): read-only root filesystem, writable only in
# the volume and these two tmpfs; only the capabilities the image's entrypoint needs to
# prepare its directories and drop to the postgres user.
ReadOnly=true
Tmpfs=/var/run/postgresql
Tmpfs=/tmp
DropCapability=all
AddCapability=CHOWN SETUID SETGID FOWNER DAC_OVERRIDE
NoNewPrivileges=true
# Resource limits: the only place they are written (docs/COMPATIBILITY.md).
PodmanArgs=--memory={{ postgres_memory }} --cpus={{ postgres_cpus }}
PidsLimit={{ postgres_pids_limit }}
ShmSize={{ postgres_shm_size }}

[Service]
Restart=on-failure
# Quadlet waits for the container to start; the image is pulled beforehand by Ansible.
TimeoutStartSec=120
# PostgreSQL needs time to write a checkpoint on a clean shutdown.
TimeoutStopSec=90

[Install]
WantedBy=default.target
