# {{ ansible_managed | default('Managed by infra-podman') }}
# Access to {{ postgres_name }} (docs/POSTGRES.md, section 3). The first matching line wins.
# TYPE  DATABASE  USER  ADDRESS  METHOD

# 1. The socket inside the container: whoever gets here is already the service user.
local   all  all  trust

# 2. The superuser never over TCP (pgAdmin's exception arrives in phase 2, R37).
host    all  {{ postgres_superuser }}  0.0.0.0/0  reject
host    all  {{ postgres_superuser }}  ::/0       reject

# 3. backup never over TCP: it reads through the socket only.
host    all  backup  0.0.0.0/0  reject
host    all  backup  ::/0       reject

# 4. One line per application user: only its database, only from the network of its
#    consumer, whose subnet Podman chose. Without that network yet, no line: rejected.
{% for db in postgres_databases %}
{% for user in db.users or [] %}
{% if user.consumer in postgres_subnets %}
host    "{{ db.name }}"  "{{ user.name }}"  {{ postgres_subnets[user.consumer] }}  scram-sha-256
{% else %}
# {{ user.name }}: the network of {{ user.consumer }} does not exist yet
{% endif %}
{% endfor %}
{% endfor %}

# 5. Anything else.
host    all  all  0.0.0.0/0  reject
host    all  all  ::/0       reject
