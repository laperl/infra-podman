# {{ ansible_managed | default('Managed by infra-podman') }}
# Access to {{ postgres_name }} (docs/POSTGRES.md, section 3). The first matching line wins.
# TYPE  DATABASE  USER  ADDRESS  METHOD

# 1. The socket inside the container: whoever gets here is already the service user.
local   all  all  trust

{% if postgres_admins %}
# 2a. The superuser, to every database, only from the network of each pgAdmin that
#     administers this instance (R37), whose subnet Podman chose.
{% for admin in postgres_admins %}
{% if admin in postgres_subnets %}
host    all  {{ postgres_superuser }}  {{ postgres_subnets[admin] }}  scram-sha-256
{% else %}
# {{ postgres_superuser }} from {{ admin }}: its network does not exist yet
{% endif %}
{% endfor %}

{% endif %}
{# The comment below keeps its old words, so that the file of an existing instance does
   not change when no pgAdmin administers it: its exception is 2a, above. -#}
# 2. The superuser never over TCP (pgAdmin's exception arrives in phase 2, R37).
host    all  {{ postgres_superuser }}  0.0.0.0/0  reject
host    all  {{ postgres_superuser }}  ::/0       reject

# 3. backup never over TCP: it reads through the socket only.
host    all  backup  0.0.0.0/0  reject
host    all  backup  ::/0       reject

{# Each application that connects here (docs/NETWORK.md): every user of each database it
   names in pg_hba, only to that database, only from the network of that pair. The comment
   below keeps its old words, so that the file of an existing instance does not change. -#}
# 4. One line per application user: only its database, only from the network of its
#    consumer, whose subnet Podman chose. Without that network yet, no line: rejected.
{% for db in postgres_databases %}
{% for entry in postgres_hba_entries | selectattr('database', 'equalto', db.name) %}
{% for user in db.users | default([], true) %}
{% if entry.client in postgres_subnets %}
host    "{{ db.name }}"  "{{ user.name }}"  {{ postgres_subnets[entry.client] }}  scram-sha-256
{% else %}
# {{ user.name }} from {{ entry.client }}: its network does not exist yet
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}

# 5. Anything else.
host    all  all  0.0.0.0/0  reject
host    all  all  ::/0       reject
