[Desktop Entry]
# {{ ansible_managed | default('Managed by infra-podman') }}
# Launcher in the operator's menu (R47): opens this pgAdmin 4 instance in the browser of the inventory.
Type=Application
Version=1.5
Name={{ pgadmin_launcher_name }}
Comment=pgAdmin 4 {{ pgadmin_instance }} ({{ infra_env }}), {{ pgadmin_url }}
# The browser of the inventory (launcher_command), then the address. Each word is checked by
# the role (tasks/main.yml): nothing that needs quoting in a Desktop Entry.
Exec={{ (pgadmin_launcher_command + [pgadmin_url]) | join(' ') }}
Icon=applications-development
Terminal=false
Categories=Development;Database;
