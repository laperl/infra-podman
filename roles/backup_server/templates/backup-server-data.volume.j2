# {{ ansible_managed | default('Managed by infra-podman') }}
# Copies of the backups received by {{ backup_server_name }}, encrypted by restic on the
# client. Never removed when the service is destroyed (SPEC 4.2).
[Volume]
VolumeName={{ backup_server_volume }}
Label=infra.env={{ infra_env }}
Label=infra.app=backup
Label=infra.component=data
Label=infra.managed-by=infra-podman
