# {{ ansible_managed | default('Managed by infra-podman') }}
# What vmagent reads on this machine (roles/obs_agent, R62). Everything on 127.0.0.1.
global:
  scrape_interval: {{ obs_agent_scrape_interval }}
scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:{{ obs_agent_node_exporter_port }}"]
  - job_name: vmagent
    static_configs:
      - targets: ["127.0.0.1:{{ obs_agent_vmagent_port }}"]
{% if inventory_hostname in groups.get('obs_store_hosts', []) %}
  # The store, on this same machine.
  - job_name: victoriametrics
    static_configs:
      - targets: ["127.0.0.1:{{ obs_agent_metrics_port }}"]
  - job_name: victorialogs
    static_configs:
      - targets: ["127.0.0.1:{{ obs_agent_logs_port }}"]
{% endif %}
{% for obs_agent_target in obs_agent_extra_targets %}
  - job_name: {{ obs_agent_target.job }}
    metrics_path: {{ obs_agent_target.path | default('/metrics') }}
    static_configs:
      - targets: ["{{ obs_agent_target.target }}"]
{% endfor %}
