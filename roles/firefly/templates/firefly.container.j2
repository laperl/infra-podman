# {{ ansible_managed | default('Managed by infra-podman') }}
[Unit]
Description=Firefly III {{ firefly_instance }} ({{ infra_env }})
# SPEC 4.3: it needs its PostgreSQL. Requires/After order the start; ExecStartPre (below)
# waits until PostgreSQL is healthy, because Notify=healthy does not exist in Podman 4.9.
Requires={{ firefly_pg_name }}.service
After={{ firefly_pg_name }}.service

[Container]
ContainerName={{ firefly_name }}
Image={{ firefly_container_image }}
Label=infra.env={{ infra_env }}
Label=infra.app={{ firefly_short }}-{{ firefly_instance }}
Label=infra.component=app
Label=infra.managed-by=infra-podman

# Attachments: the volume the official image declares (docs/services/firefly.md, 5).
Volume={{ firefly_volume }}.volume:/var/www/html/storage/upload:Z

# Only its own network to PostgreSQL: internal, no way out, and no other instance in it
# (SPEC 4.4, R45, R48). It is published where the operator wrote in inbound.publish of the
# inventory (R55), from that same internal network.
Network={{ firefly_network }}.network
{% for firefly_published in firefly_publish %}
PublishPort={{ firefly_published }}
{% endfor %}

# Secrets as files (SPEC 4.5), read by the image through the *_FILE variables. The
# image runs as www-data (uid 33), which must be able to read them.
Secret={{ firefly_app_key_secret }},type=mount,target=/run/secrets/app-key,uid=33,gid=33,mode=0400
Secret={{ firefly_db_secret }},type=mount,target=/run/secrets/db-password,uid=33,gid=33,mode=0400
Environment=APP_KEY_FILE=/run/secrets/app-key
Environment=DB_PASSWORD_FILE=/run/secrets/db-password

# The image's variables, as documented in Firefly's .env.example (v6.7.9).
Environment=APP_ENV=production
Environment=APP_DEBUG=false
Environment=APP_URL={{ firefly_url }}
Environment=DEFAULT_LANGUAGE={{ firefly_language }}
Environment=DEFAULT_LOCALE=equal
Environment=TZ={{ firefly_timezone }}
Environment=LOG_CHANNEL=stdout
Environment=APP_LOG_LEVEL={{ firefly_log_level }}
Environment=AUDIT_LOG_LEVEL=emergency
Environment=DB_CONNECTION=pgsql
Environment=DB_HOST={{ firefly_pg_name }}
Environment=DB_PORT=5432
Environment=DB_DATABASE={{ firefly_db_name }}
Environment=DB_USERNAME={{ firefly_db_user }}
# The database has no public schema: Firefly's tables go in the schema of its database
# (docs/POSTGRES.md, section 2).
Environment=PGSQL_SCHEMA={{ firefly_db_name }}
Environment=DKR_CHECK_SQLITE=false
# Nothing leaves the machine (docs/services/firefly.md, 2): no mail, no error reports by
# mail, and the defaults of what would go to the internet, off. The network blocks it anyway.
Environment=MAIL_MAILER=log
Environment=SEND_ERROR_MESSAGE=false
Environment=ENABLE_EXTERNAL_MAP=false
Environment=ENABLE_EXTERNAL_RATES=false
Environment=ALLOW_WEBHOOKS=false

# GET /health answers OK only when Firefly reads its database. The first start creates
# the tables, hence the long start period. Podman runs it with sh -c.
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/health
HealthInterval=30s
HealthStartPeriod=180s
HealthRetries=3
HealthTimeout=10s

# Hardening: the image already runs as www-data; no capabilities, no new privileges.
DropCapability=all
NoNewPrivileges=true
# Resource limits (R46), the only place they are written (docs/COMPATIBILITY.md). StopSignal=
# does not exist in Quadlet 4.9: SIGINT, as in Firefly's official docker-compose.yml.
PodmanArgs=--memory={{ firefly_memory }} --cpus={{ firefly_cpus }} --stop-signal=SIGINT
PidsLimit={{ firefly_pids_limit }}

[Service]
# SPEC 4.3: wait, at most TimeoutStartSec, until PostgreSQL passes its healthcheck.
ExecStartPre=/bin/sh -c 'until podman healthcheck run {{ firefly_pg_name }} >/dev/null 2>&1; do sleep 3; done'
TimeoutStartSec={{ firefly_start_timeout }}
Restart=on-failure

[Install]
WantedBy=default.target
