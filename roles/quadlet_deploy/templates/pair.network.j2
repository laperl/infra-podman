# {{ ansible_managed | default('Managed by infra-podman') }}
{# The one template of the network of a pair of instances (docs/NETWORK.md), used by both
   roles of the pair through quadlet_deploy, with a unit item like:
     - template: pair.network.j2
       common: true
       name: <env>-<client>-<receiver>-net.network
       app: <receiver>
   Both sides render it from the same inventory, so the file is the same whichever writes
   it. A pair with PostgreSQL uses roles/postgres/templates/pg-client.network.j2, with the
   same keys: the postgres role writes it, because pg_hba.conf needs its subnet. -#}
# Network of one pair of instances (docs/NETWORK.md): only these two containers. Internal:
# no way out to the internet, the LAN or the host, not even by DNS. Isolated from every
# other isolated network. No Subnet=: Podman chooses a free one.
[Network]
NetworkName={{ item.name | regex_replace('\.network$', '') }}
Internal=true
Options=isolate=true
# Podman's DNS of the network resolves the names of its containers and sends any other
# question to the host's servers, even on an internal network (aardvark-dns 1.4, Podman
# 4.9): a way out for data. Sent here instead, where nothing answers (R45).
DNS=127.0.0.1
Label=infra.env={{ infra_env }}
Label=infra.app={{ item.app }}
Label=infra.component=net
Label=infra.managed-by=infra-podman
